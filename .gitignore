flow/2_static/fv_pipe_ctrl/sby/pipe_ctrl_*/
# ---- Track A open-tool flow (Docs/handbook/H2_running.md, "Log convention") ----
# Per-run logs, builds, waves and coverage databases stay local; summaries,
# history and cited evidence are committed. *.log is ignored above, so the
# committed evidence logs are re-included explicitly.
logs/**/raw/
!logs/**/evidence/*.log
.garuda_bin/
obj_dir/
*.vvp

# NCLaunch state written in the design directory (flow/cov/<blk>_ncl*.tcl runs)
.nclaunch.dd

# Cadence tool state written into the repo root by NCLaunch / JasperGold runs
/hdl.var
/nclaunch.key
/.nclaunch.dd*
/jgproject/
# runner summaries of partial (--only) runs; the full-suite summaries are the record
logs/*/summary/*.partial.tsv
logs/*/summary/*.partial.txt
