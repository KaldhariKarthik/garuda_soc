// =============================================================================
// GARUDA SoC regression for vManager - flow stages 3 to 6.
//
//   cd ~/garuda_soc && source scripts/setup_env.sh
//   export GARUDA_ROOT=$PWD
//   vmanager -local sim/vm_db &          then  Regression > Launch, this file
//   (batch: vmanager -local sim/vm_db -batch -launch flow/regress/garuda.vsif)
//
// Every test is one call of flow/regress/run_test.sh <test name>: irun 15.2,
// coverage on, assertions on. A run fails on any simulator error (assertion
// failures included), any [FAIL] line, or a missing pass marker.
// Launch one group for one flow stage, or the whole file for everything.
// =============================================================================

session garuda_soc {
    top_dir              : $ENV(GARUDA_ROOT)/sim/vm_sessions;
    output_mode          : log_only;
    drm                  : "Parallel Local";
    max_runs_in_parallel : 8;
    description          : <text>GARUDA SoC, flow stages 3-6: block, core, integration, SoC top</text>;
};

group garuda {
    run_script  : <text>GARUDA_RUN_DIR=$DIR(run) $ENV(GARUDA_ROOT)/flow/regress/run_test.sh $ATTR(test_name)</text>;
    scan_script : "vm_scan.pl ius.flt ies_coverage.flt $ENV(GARUDA_ROOT)/flow/regress/garuda.flt";
    timeout     : 900;
    count       : 1;

    // ---- stage 3: block and IP -------------------------------------------------
    group block {
        test tb_crg {}; test tb_mem {}; test tb_dma {}; test tb_clic {};
        test tb_timers {}; test tb_debug {}; test tb_spim {}; test tb_spis {};
        test tb_i2c {}; test tb_uart {}; test tb_gpio {}; test tb_pwm {};
    };

    // ---- stage 4: CPU core -----------------------------------------------------
    // unit and element testbenches, DSU against its model, ISA tests in lockstep
    // with Spike, directed sanity tests
    group core {
        group core_units {
            test unit_decode_control {}; test unit_imm_gen {}; test unit_reg_file {};
            test unit_branch_predict {}; test unit_hazard_fwd_unit {}; test unit_id_stage {};
            test unit_alu_unit {}; test unit_mul32 {}; test unit_branch_unit {};
            test unit_csr_rw {}; test unit_clic_ctrl {}; test unit_load_store_unit {};
            test unit_load_formatter {}; test unit_mem_wb_reg {}; test unit_garuda_pc_gen {};
            test unit_prefetch_buf {}; test unit_iport_master {}; test unit_dport_master {};
            test unit_mem_stage {}; test unit_if_stage_top {}; test unit_forward_unit {};
        };
        // the plain-Verilog benches of the pipeline registers and control (G4 section 2);
        // tb_core_halt needs an image and runs as prog_halt__* below
        group core_smokes {
            test smoke_ex_smoke {}; test smoke_exmem_ifid {}; test smoke_idex_fwd {}; test smoke_pipe_ctrl {};
            test smoke_trap_ctrl {}; test smoke_csr_file {}; test smoke_csr_file_t12 {};
        };
        group core_dsu {
            test dsu {};
        };
        group core_isa {
            test isa_add {}; test isa_addi {}; test isa_and {}; test isa_andi {}; test isa_auipc {};
            test isa_beq {}; test isa_bge {}; test isa_bgeu {}; test isa_blt {}; test isa_bltu {};
            test isa_bne {}; test isa_fence_i {}; test isa_jal {}; test isa_jalr {}; test isa_lb {};
            test isa_lbu {}; test isa_ld_st {}; test isa_lh {}; test isa_lhu {}; test isa_lui {};
            test isa_lw {}; test isa_mul {}; test isa_mulh {}; test isa_mulhsu {}; test isa_mulhu {};
            test isa_or {}; test isa_ori {}; test isa_p_csr {}; test isa_p_div {}; test isa_p_divu {};
            test isa_p_illegal {}; test isa_p_lh_misaligned {}; test isa_p_lw_misaligned {}; test isa_p_ma_addr {}; test isa_p_ma_data {};
            test isa_p_ma_fetch {}; test isa_p_mcsr {}; test isa_p_rem {}; test isa_p_remu {}; test isa_p_sbreak {};
            test isa_p_scall {}; test isa_p_sh_misaligned {}; test isa_p_shamt {}; test isa_p_sw_misaligned {}; test isa_p_zicntr {};
            test isa_sb {}; test isa_sh {}; test isa_simple {}; test isa_sll {}; test isa_slli {};
            test isa_slt {}; test isa_slti {}; test isa_sltiu {}; test isa_sltu {}; test isa_sra {};
            test isa_srai {}; test isa_srl {}; test isa_srli {}; test isa_st_ld {}; test isa_sub {};
            test isa_sw {}; test isa_xor {}; test isa_xori {};
        };
        group core_sanity {
            test san_t_loadbranch {}; test san_t_flush {}; test san_t_buserr {}; test san_t_irq {};
            test san_t_wfi {}; test san_t_dsu {}; test san_t_mem {}; test san_t_clic {};
            test san_t_cov {}; test san_t_mtip {};
            test san_t_hold_flush_matrix {}; test san_t_dsu_b2b {};
            test san_t_lead1_mret_buserr {}; test san_t_lead2_wfi_buserr {};
            test san_t_hazard {}; test san_t_hazard_nowait {}; test san_t_cov_fault {}; test san_t_cov_csr {};
        };
        // G5 5.5, 5.8: three seeds of every riscv-dv test for coverage (run_test.sh dv_*;
        // `make riscv_dv` builds them and compares each with Spike first)
        group core_riscv_dv {
            test dv_arith_s1 {}; test dv_arith_s2 {}; test dv_arith_s3 {};
            test dv_rand_instr_s1 {}; test dv_rand_instr_s2 {}; test dv_rand_instr_s3 {};
            test dv_jump_stress_s1 {}; test dv_jump_stress_s2 {}; test dv_jump_stress_s3 {};
            test dv_loop_s1 {}; test dv_loop_s2 {}; test dv_loop_s3 {};
            test dv_rand_jump_s1 {}; test dv_rand_jump_s2 {}; test dv_rand_jump_s3 {};
            test dv_mmu_stress_s1 {}; test dv_mmu_stress_s2 {}; test dv_mmu_stress_s3 {};
            test dv_no_fence_s1 {}; test dv_no_fence_s2 {}; test dv_no_fence_s3 {};
            test dv_illegal_s1 {}; test dv_illegal_s2 {}; test dv_illegal_s3 {};
            test dv_ebreak_s1 {}; test dv_ebreak_s2 {}; test dv_ebreak_s3 {};
            test dv_unaligned_s1 {}; test dv_unaligned_s2 {}; test dv_unaligned_s3 {};
        };
        // G5 5.8, 5.9: the core programs that until 2026-11-11 ran only on the open
        // flow; each is one row of tb/core/run/<suite>.toml (run_test.sh prog_*)
        group core_programs {
            test prog_sanity__t_dsu_gate {}; test prog_sanity__t_cov_wfi_mti {};
            test prog_directed__t_core_mret_buserr {}; test prog_directed__t_core_mret_buserr_w2 {};
            test prog_directed__t_core_wfi_buserr {}; test prog_directed__t_core_wfi_buserr_w2 {};
            test prog_directed__t_core_trap_wfi {}; test prog_directed__t_core_trap_wfi_w2 {};
            test prog_directed__t_core_wfi_mret {}; test prog_directed__t_core_wfi_mret_w2 {}; test prog_directed__t_core_wfi_mret_w3 {};
            test prog_directed__t_core_ctl {}; test prog_directed__t_core_ctl_w3 {};
            test prog_directed__t_core_irq_nest {}; test prog_directed__t_core_irq_nest_w2 {};
            test prog_directed__t_core_preempt {}; test prog_directed__t_core_preempt_w2 {};
            test prog_directed__t_exc_priority {}; test prog_directed__t_exc_priority_w3 {};
            test prog_covtests__t_cov_fault_w3 {}; test prog_covtests__t_cov_csr_ro {}; test prog_covtests__t_cov_irq_ids {}; test prog_covtests__t_cov_irq_ids_fstop {}; test prog_covtests__t_cov_illegal {};
            test prog_covtests__t_cov_dsu {}; test prog_covtests__t_dsu_ovf_raw {};
            test prog_covtests__t_cov_rereset {}; test prog_covtests__t_cov_rereset_w2 {};
            test prog_covtests__t_cov_irq {}; test prog_covtests__t_cov_irq_w2 {};
            test prog_covtests__t_cov_misfetch {}; test prog_covtests__t_cov_misfetch_w2 {};
            test prog_covtests__t_cov_misfetch_d3 {}; test prog_covtests__t_dsu_macsat_rd {};
            test prog_covtests__t_cov_vplan {}; test prog_covtests__t_cov_vplan_w2 {};
            test prog_extra__boot6 {}; test prog_extra__ctest1 {}; test prog_extra__dsu_flag2 {};
            test prog_perf__perf_nowait {}; test prog_perf__perf_w2 {}; test prog_perf__perf_rand {};
            test prog_halt__t_core_hartreset_s1 {}; test prog_halt__t_core_hartreset_s2 {};
            test prog_halt__t_core_hartreset_s3 {}; test prog_halt__t_core_hartreset_timeout {};
            test prog_csr__t12_level_stack {};
        };
    };

    // ---- stage 5: integration --------------------------------------------------
    group integ {
        test tb_ahb_ic {}; test tb_ahb_ic_wait {}; test tb_bridge {}; test tb_apb_shim {};
    };

    // ---- stage 6: the chip from the pins ---------------------------------------
    group soc {
        test chip_basic {}; test chip_irq {}; test chip_wdt {}; test chip_flash {};
        test chip_uart {}; test chip_periph {}; test chip_integ {}; test chip_jtag {};
        // 2026-11-20 (TOOL-A31): five chip programs that ran only under Verilator (dma_chip suite,
        // make test_chip_swirq) and so never reached the coverage merge
        test chip_swirq {}; test chip_dma_rearm {}; test chip_dma_traffic {};
        test chip_dma_subword {}; test chip_dma_uart {};
        // 2026-11-21: the chip top's own wires (D-40 coverage closure of TOP)
        test chip_cov {};
        // 2026-11-21 (G6 6.8, 6.14): seeded random traffic with the SBA as a fourth master
        test chip_stress {};
    };
};
