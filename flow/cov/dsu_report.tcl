# dsu_report.tcl -- GENERATED by tools/cov/gen_cadence_cov.py dsu.
#     imc -exec flow/cov/dsu_report.tcl     (after flow/cov/dsu_cadence.sh merged the runs)
# Loads sim/cov_dsu/cov_work/scope/all, applies flow/cov/dsu_exclusions.tcl (written from the
# DUT top `dsu_top`; mapped here onto the main bench's instance tb_dsu_top.dut), writes three reports.
load -run sim/cov_dsu/cov_work/scope/all
set f [open flow/cov/dsu_exclusions.tcl r]
set n 0; set bad 0
foreach line [split [read $f] "\n"] {
    if {[string match {exclude *} $line]} {
        set line [string map {"-inst dsu_top" "-inst tb_dsu_top.dut"} $line]
        if {[catch {eval $line} err]} { incr bad; puts "exclusion not applied: $line -- $err" } else { incr n }
    }
}
close $f
puts "exclusions applied: $n, not applied: $bad"
report -summary -inst tb_dsu_top.dut... -metrics block:expression:toggle:fsm -out sim/cov_dsu/code_cov.txt
report -summary -inst tb_dsu_top.dut... -metrics toggle -exclComments -out sim/cov_dsu/waivers_applied.txt
report -detail -metrics covergroup -out sim/cov_dsu/func_cov.txt
exit
