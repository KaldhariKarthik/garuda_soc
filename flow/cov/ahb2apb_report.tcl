# ahb2apb_report.tcl -- GENERATED by tools/cov/gen_cadence_cov.py ahb2apb.
#     imc -exec flow/cov/ahb2apb_report.tcl     (after flow/cov/ahb2apb_cadence.sh merged the runs)
# Loads sim/cov_ahb2apb/cov_work/scope/all, applies flow/cov/ahb2apb_exclusions.tcl (written from the
# DUT top `ahb2apb_bridge`; mapped here onto the main bench's instance tb_apb_env.u_dut), writes three reports.
load -run sim/cov_ahb2apb/cov_work/scope/all
set f [open flow/cov/ahb2apb_exclusions.tcl r]
set n 0; set bad 0
foreach line [split [read $f] "\n"] {
    if {[string match {exclude *} $line]} {
        set line [string map {"-inst ahb2apb_bridge" "-inst tb_apb_env.u_dut"} $line]
        if {[catch {eval $line} err]} { incr bad; puts "exclusion not applied: $line -- $err" } else { incr n }
    }
}
close $f
puts "exclusions applied: $n, not applied: $bad"
report -summary -inst tb_apb_env.u_dut... -metrics block:expression:toggle:fsm -out sim/cov_ahb2apb/code_cov.txt
report -summary -inst tb_apb_env.u_dut... -metrics toggle -exclComments -out sim/cov_ahb2apb/waivers_applied.txt
report -detail -metrics covergroup -out sim/cov_ahb2apb/func_cov.txt
exit
