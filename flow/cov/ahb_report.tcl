# ahb_report.tcl -- GENERATED by tools/cov/gen_cadence_cov.py ahb.
#     imc -exec flow/cov/ahb_report.tcl     (after flow/cov/ahb_cadence.sh merged the runs)
# Loads sim/cov_ahb/cov_work/scope/all, applies flow/cov/ahb_exclusions.tcl (written from the
# DUT top `ahb_interconnect`; mapped here onto the main bench's instance tb_ahb_env.u_dut), writes three reports.
load -run sim/cov_ahb/cov_work/scope/all
set f [open flow/cov/ahb_exclusions.tcl r]
set n 0; set bad 0
foreach line [split [read $f] "\n"] {
    if {[string match {exclude *} $line]} {
        set line [string map {"-inst ahb_interconnect" "-inst tb_ahb_env.u_dut"} $line]
        if {[catch {eval $line} err]} { incr bad; puts "exclusion not applied: $line -- $err" } else { incr n }
    }
}
close $f
puts "exclusions applied: $n, not applied: $bad"
report -summary -inst tb_ahb_env.u_dut... -metrics block:expression:toggle:fsm -out sim/cov_ahb/code_cov.txt
report -summary -inst tb_ahb_env.u_dut... -metrics toggle -exclComments -out sim/cov_ahb/waivers_applied.txt
report -detail -metrics covergroup -out sim/cov_ahb/func_cov.txt
exit
