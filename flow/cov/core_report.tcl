# core_report.tcl -- GENERATED by tools/cov/gen_cadence_cov.py core.
#     imc -exec flow/cov/core_report.tcl     (after flow/cov/core_cadence.sh merged the runs)
# Loads sim/cov_core/cov_work/scope/all, applies flow/cov/core_exclusions.tcl (written from the
# DUT top `garuda_core_top`; mapped here onto the main bench's instance tb_boot.dut), writes three reports.
load -run sim/cov_core/cov_work/scope/all
set f [open flow/cov/core_exclusions.tcl r]
set n 0; set bad 0
foreach line [split [read $f] "\n"] {
    if {[string match {exclude *} $line]} {
        set line [string map {"-inst garuda_core_top" "-inst tb_boot.dut"} $line]
        if {[catch {eval $line} err]} { incr bad; puts "exclusion not applied: $line -- $err" } else { incr n }
    }
}
close $f
puts "exclusions applied: $n, not applied: $bad"
report -summary -inst tb_boot.dut... -metrics block:expression:toggle:fsm -out sim/cov_core/code_cov.txt
report -summary -inst tb_boot.dut... -metrics toggle -exclComments -out sim/cov_core/waivers_applied.txt
report -detail -metrics covergroup -out sim/cov_core/func_cov.txt
exit
