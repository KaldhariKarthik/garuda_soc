# Code coverage of the three UART instances of the UVM bench tb_uart_uvm, not the testbench.
# -covdut cannot be used: it refuses a module with more than one instance.
deselect_coverage -all -instance tb_uart_uvm...
select_coverage -all -instance tb_uart_uvm.g_uart[0].dut...
select_coverage -all -instance tb_uart_uvm.g_uart[1].dut...
select_coverage -all -instance tb_uart_uvm.g_uart[2].dut...
