# =============================================================================
# spim_exclusions.tcl - coverage waivers for the SPI master (D-40, 2026-11-20), measured in the
# main merge. Per design type. Every line has its reason; cov_chart fails on a line that matches
# nothing (IMC *W,NOMATCH). The vendored engine's quad-SPI paths are one reason (spec section 13,
# one reason per IP, Karthik 2026-11-20); every other line is a tie-off or a constant field.
# Chip selects 2 and 3, the RX FIFO full stall, 65535-bit transfers and all register bits are
# covered by tests in tb/spi_master/tb_spim.sv, not excluded.
# =============================================================================
exclude -type spim_ctrl -block 69 -comment "en_quad_int set on a quad start: the quad-SPI mode is not used: the wrapper clears STATUS\[3:2\] before the IP (garuda_spim_top.sv:157-158, SPIM \[N-7.5\], spec section 13)"
exclude -type spi_master_rx -block 10 -comment "the four-lane shift of a quad read: the quad-SPI mode is not used: the wrapper clears STATUS\[3:2\] before the IP (garuda_spim_top.sv:157-158, SPIM \[N-7.5\], spec section 13)"
exclude -type spim_ctrl -block 48 -comment "the MODE state: no transition of spim_ctrl enters it (state_next is never MODE, spim_ctrl.sv), Superlint BLK_NO_RCHB class VENDOR_UNUSED_MODE (SPIM-2)"
exclude -type spim_ctrl -state state.MODE -comment "the MODE state: no transition of spim_ctrl enters it (state_next is never MODE), SPIM-2"
exclude -type spim_ctrl -expression 1.1.3 1.1.4 2.1.2 3.1.1 3.1.2 4.1.2 5.1.2 -comment "the spi_qrd and spi_qwr terms of the start and direction decodes: the quad-SPI mode is not used: the wrapper clears STATUS\[3:2\] before the IP (garuda_spim_top.sv:157-158, SPIM \[N-7.5\], spec section 13)"
exclude -type spim_ctrl -toggle spi_qrd -comment "quad start strobe, constant 0: the quad-SPI mode is not used: the wrapper clears STATUS\[3:2\] before the IP (garuda_spim_top.sv:157-158, SPIM \[N-7.5\], spec section 13)"
exclude -type spim_ctrl -toggle spi_qwr -comment "quad start strobe, constant 0: the quad-SPI mode is not used: the wrapper clears STATUS\[3:2\] before the IP (garuda_spim_top.sv:157-158, SPIM \[N-7.5\], spec section 13)"
