# dma_report.tcl -- GENERATED by tools/cov/gen_cadence_cov.py dma.
#     imc -exec flow/cov/dma_report.tcl     (after flow/cov/dma_cadence.sh merged the runs)
# Loads sim/cov_dma/cov_work/scope/all, applies flow/cov/dma_exclusions.tcl (written from the
# DUT top `dma_top`; mapped here onto the main bench's instance tb_dma_env.dut), writes three reports.
load -run sim/cov_dma/cov_work/scope/all
set f [open flow/cov/dma_exclusions.tcl r]
set n 0; set bad 0
foreach line [split [read $f] "\n"] {
    if {[string match {exclude *} $line]} {
        set line [string map {"-inst dma_top" "-inst tb_dma_env.dut"} $line]
        if {[catch {eval $line} err]} { incr bad; puts "exclusion not applied: $line -- $err" } else { incr n }
    }
}
close $f
puts "exclusions applied: $n, not applied: $bad"
report -summary -inst tb_dma_env.dut... -metrics block:expression:toggle:fsm -out sim/cov_dma/code_cov.txt
report -summary -inst tb_dma_env.dut... -metrics toggle -exclComments -out sim/cov_dma/waivers_applied.txt
report -detail -metrics covergroup -out sim/cov_dma/func_cov.txt
exit
