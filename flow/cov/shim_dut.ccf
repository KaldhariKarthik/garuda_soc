# Code coverage of the two shim instances of tb_apb_shim only, not the testbench.
# -covdut cannot be used here: it refuses a module with more than one instance.
deselect_coverage -all -instance tb_apb_shim...
select_coverage -all -instance tb_apb_shim.dut...
select_coverage -all -instance tb_apb_shim.dut_b...
