# Code coverage of the three UART instances of tb_uart only, not the testbench.
# -covdut cannot be used here: it refuses a module with more than one instance.
deselect_coverage -all -instance tb_uart...
select_coverage -all -instance tb_uart.dut...
select_coverage -all -instance tb_uart.dut1...
select_coverage -all -instance tb_uart.dut2...
