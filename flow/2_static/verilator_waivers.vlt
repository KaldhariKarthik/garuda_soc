// =============================================================================
// Lint of garuda_chip_top with Verilator: what is accepted, and why (plan task 3.1).
// (No comment here may begin with the word Verilator: the tool reads it as a pragma.)
// Read by `make local_lint`. Every line has its reason; a warning that is not
// listed here fails the target. Written 2026-10-14 against Verilator 5.053.
// =============================================================================
`verilator_config

// ---- vendored IP: never edited here (decision D-22); a change is a recorded patch
// Width mismatches in comparisons and zero-extensions of the PULP SPI master and
// the OpenCores I2C bit controller. Each is a narrower value compared with or
// assigned to a wider one: the result is the zero-extended value in every tool.
lint_off -rule WIDTHEXPAND    -file "*rtl/third_party/pulp/axi_spi_master/src/spi_master_fifo.sv"
lint_off -rule WIDTHEXPAND    -file "*rtl/third_party/pulp/axi_spi_master/src/spim_ctrl.sv"
lint_off -rule WIDTHTRUNC     -file "*rtl/third_party/opencores/i2c/src/i2c_bit_ctrl.sv" -lines 248
// Case statements without a default inside clocked blocks: an unlisted value
// leaves the registers as they are, which is the intended behaviour, and no latch
// is inferred (the places HAL reports as CDEFNC in the vendor review, flow/ZERO_WAIVER.md).
lint_off -rule CASEINCOMPLETE -file "*rtl/third_party/pulp/apb_spi_master/src/apb_spi_master.sv"
lint_off -rule CASEINCOMPLETE -file "*rtl/third_party/pulp/apb_spi_master/src/spim_apb_if.sv"
lint_off -rule CASEINCOMPLETE -file "*rtl/third_party/pulp/axi_spi_master/src/spim_ctrl.sv"
lint_off -rule CASEINCOMPLETE -file "*rtl/third_party/pulp/apb_gpio/src/apb_gpio.sv"

// (2026-11-20, D-40: four entries removed as stale. Linted with no waivers, none matched
// a warning: the clock gate's enable latch is an always_latch, which raises none, and the
// three open width mismatches of ahb2apb_apb_fsm and dma_engine were fixed in the F4 rewrites.
// An unused lint_off is never reported by the tool; tools/waiver_audit.py lists every entry.)

// Checker code (2026-11-20, D-40): the three whole-file waivers over *_sva.sv and *_props_a.sv
// are gone; their 58 width warnings were fixed in the checkers (casts where a narrow state
// or counter meets an integer constant, 2-bit constants for the 2-bit DMA error phase).
// One line stays: a_arb_prio is written for any priority map, and with the shipped map
// channel 5 has priority 0 (PRIO[17:15] = 0), so "PRIO[..] >= PRIO[17:15]" is always true.
lint_off -rule UNSIGNED       -file "*rtl/dma/dma_sva.sv"              -lines 83
