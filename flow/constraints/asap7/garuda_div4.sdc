# =============================================================================
# GARUDA / ASAP7: timing scenario DIV4  (DIVSEL = 2'b01)
# GENERATED by gen_modes.py; edit the generator, not this file.
#
# EXPLORATORY. Time unit = 1 ps (ASAP7 liberty). Object names are from the
# ORFS/Yosys netlist of garuda_chip_core (synth_r2) and must be re-checked
# after resynthesis.
# Clock relationships follow the RTL (clk_div.v, reset_ctrl.v, core_clk_gate.v,
# dmi_cdc.v) and GARUDA-CLKRST-SPEC-001. Every I/O number is PROVISIONAL (sec 7).
# No result obtained with this file is timing closure, and none carries over to
# TSMC 28 nm.
# =============================================================================

# ---- 1. reference: the only refclk load is u_clk_div.t1_q (checked: fanout 1)
create_clock -name refclk -period 2000 [get_ports refclk]
set_input_transition 100 [get_ports refclk]          ;# PHYS 5.2: 0.10 ns
set_clock_uncertainty -setup 150 [get_clocks refclk] ;# PHYS 5.2: 0.15 ns

# ---- 2. the divider chain: every derived clock is given its EXACT edges,
#      counted in refclk edges (-edges; edge 1 = refclk rise at 0, 3 = rise
#      at 2000, ...). This is the physical behaviour of the RTL: t1 toggles on
#      each refclk rise; t2, t3 and t4 toggle on the rise of the previous
#      stage; so every rise of t1..t4, hclk and pclk lands on a t1 rise, and t1
#      rises on refclk edges 1, 5, 9, ... ASAP7 flops have only QN, so the
#      clocks are defined on QN pins with QN's edges; the netlist inverts QN
#      onto the tN_q / aon_clk / pclk nets, and STA reports flops there as
#      `<clock>'`, the same physical edge as the RTL clock.
#      Why -edges (2026-10-13, late): a plain -divide_by on QN, and -invert,
#      each put aon_clk half a period (2000 ps) out of phase with hclk. That was
#      pessimistic for setup but OPTIMISTIC by 2 ns for hold on hclk<->aon
#      paths (Docs/PD_LOG_2026-10-13.md §7).
#      aon_clk = t1 (D-14): reset_ctrl stretch/requests/RSTREASON, sel_req_q, and
#      the negedge sel_act_q (clocked by the QN net directly).
create_generated_clock -name aon_clk -source [get_ports refclk] -edges {3 5 7} \
    [get_pins {u_clk_div.t1_q$_DFF_PN0_/QN}]
create_generated_clock -name clk_t2 -source [get_ports refclk] -edges {5 9 13} \
    [get_pins {u_clk_div.t2_q$_DFF_PN0_/QN}]
create_generated_clock -name clk_t3 -source [get_ports refclk] -edges {9 17 25} \
    [get_pins {u_clk_div.t3_q$_DFF_PN0_/QN}]
create_generated_clock -name clk_t4 -source [get_ports refclk] -edges {17 33 49} \
    [get_pins {u_clk_div.t4_q$_DFF_PN0_/QN}]

# ---- 3. hclk: the DIVSEL mux output (net hclk, RTL polarity), fixed to this
#      mode by case analysis on the active select (QN = ~sel). Edges: rise on
#      refclk edge 1, period DIV refclk periods.
set_case_analysis 0 [get_pins {u_clk_div.sel_act_q?0?$_DFFE_NN0P_/QN}]
set_case_analysis 1 [get_pins {u_clk_div.sel_act_q?1?$_DFFE_NN0P_/QN}]
create_generated_clock -name hclk -source [get_ports refclk] -edges {1 5 9} \
    [get_pins -of_objects [get_nets hclk] -filter "direction == output"]

# ---- 4. pclk = hclk / 2: toggle u_clk_div.pclk_q on each hclk rise (resets to 1,
#      so Q falls on the first hclk rise). Defined on QN, which rises on that edge.
create_generated_clock -name pclk -source [get_ports refclk] -edges {1 9 17} \
    [get_pins {u_clk_div.pclk_q$_DFF_PN1_/QN}]

# ---- 4b. derived-clock uncertainty: ASSUMPTION, provisional. No project
#      document gives one; the only stated value is refclk's 0.15 ns setup
#      (PHYS 5.2), reused here for every derived clock at the user's direction
#      (2026-10-13). Setup only, as PHYS states it; no hold uncertainty is set.
set_clock_uncertainty -setup 150 [get_clocks {aon_clk clk_t2 clk_t3 clk_t4 hclk pclk}]

# aon_clk, clk_t2..t4, hclk, pclk and the core's gated clock (AND of hclk and
# the core_clk_gate latch; gating check inferred by the tool) are ONE
# synchronous family: no set_clock_groups, no false paths among them
# (PHYS [N-5.7]). refclk reaches only t1_q, so it needs no group either.

# ---- 5. JTAG: tck, asynchronous to the family above. NOT grouped away.
create_clock -name tck -period 50000 [get_ports tck]
# The tck<->core crossing is dmi_cdc.v: toggle request/ack through 2-3 flop
# synchronisers plus a payload held stable until acknowledged. Hold checks
# between unrelated clocks are meaningless; setup is BOUNDED, not waived, at one
# hclk period of this mode, so payload skew stays visible in reports.
# PROVISIONAL-X1.
set_false_path -hold -from [get_clocks tck] -to [get_clocks {aon_clk hclk pclk}]
set_false_path -hold -from [get_clocks {aon_clk hclk pclk}] -to [get_clocks tck]
set_max_delay 8000 -ignore_clock_latency -from [get_clocks tck] -to [get_clocks {aon_clk hclk pclk}]
set_max_delay 8000 -ignore_clock_latency -from [get_clocks {aon_clk hclk pclk}] -to [get_clocks tck]

# ---- 6. ext_rst_n. All 184 loads in synth_r2 (183 in synth_r1) are
#      asynchronous RESETN/SETN pins (no data use): 9 in u_clk_div (raw-reset
#      toggles and select, release unsynchronised by design, CLKRST [N-7.16]);
#      26 in u_reset_ctrl (ext_sync_q release synchroniser, stretch counter and
#      request flops whose post-release value is held by ext_held for two aon
#      cycles, RSTREASON, exth_q/extp_q 2-flop release synchronisers); 149 in u_soc.u_debug
#      (jtag_tap/dtm/dmi_cdc por_n_i, tck domain, tck may be stopped). The pin
#      has no clock (board supervisor, PHYS B-1), so recovery/removal from it
#      cannot be timed. The exception is limited to those reset/set pins.
#      They are named as the timing endpoints the port reaches, not as the
#      loads of net ext_rst_n: placement puts an input buffer on the port, and
#      the net's only load becomes that buffer (PD-10). Checked on pnr_r7:
#      184 pins (175 RESETN, 9 SETN) after synthesis and after placement.
set_false_path -from [get_ports ext_rst_n] \
    -to [get_pins [get_fanout -from [get_ports ext_rst_n] -endpoints_only -flat] \
             -filter "lib_pin_name == RESETN || lib_pin_name == SETN"]

# ---- 7. I/O.  PROVISIONAL: every budget = IO_PCT = 30% of the relevant clock
#      period. Assumptions: (a) a pad + board budget of that size is enough; (b)
#      the SPI flash/IMU part numbers are unknown, so spim_* are treated as
#      generic outputs launched in pclk; spim_miso is synchronised in RTL
#      (u_spim.u_shim.sync0_q) and is therefore an async input; (c) the JTAG probe
#      drives tms/tdi off tck falling and samples tdo on tck rising (IEEE 1149.1
#      convention, part not known); (d) no output load or drive cell is set.
#      Replace each with datasheet values before any sign-off use.
#      Ports are garuda_chip_core's (P2): each former tri-state pin is a
#      data output plus an enable output, plus an input for I2C/GPIO. The pad
#      cells (not in this core-only flow) add their own delay to the budget.
set_input_delay  15000 -clock tck [get_ports {tms tdi}]
set_output_delay 15000 -clock tck [get_ports {tdo_o tdo_oe_o}]
set_output_delay -min 0 -clock tck [get_ports {tdo_o tdo_oe_o}]
set OUTS_PCLK [get_ports {spim_sclk spim_mosi spim_cs_flash_n spim_cs_imu_n
    uart0_tx uart1_tx uart2_tx pwm0 pwm1 pwm2 pwm3
    gpio_o* gpio_oe_o* i2c_scl_o i2c_scl_oe_o i2c_sda_o i2c_sda_oe_o
    spis_miso_o spis_miso_oe_o}]
#      SPI master outputs as generic pclk outputs; outputs to asynchronous
#      receivers (UART, PWM/ESC, GPIO, I2C, SPI-slave MISO) bounded so
#      register-to-pad stays inside one pclk period.
set_output_delay 4800 -clock pclk $OUTS_PCLK
set_output_delay -min 0 -clock pclk $OUTS_PCLK

# ---- 8. asynchronous inputs, each into a named first synchroniser stage
#      (checked in synth_r1: each port's only load is that D pin). Port -> pin only.
set_false_path -from [get_ports spim_miso] -to [get_pins {u_spim.u_shim.sync0_q$_DFF_PN0_/D}]
set_false_path -from [get_ports uart0_rx]  -to [get_pins {g_uart?0?.u_uart.u_shim.sync0_q$_DFF_PN1_/D}]
set_false_path -from [get_ports uart1_rx]  -to [get_pins {g_uart?1?.u_uart.u_shim.sync0_q$_DFF_PN1_/D}]
set_false_path -from [get_ports uart2_rx]  -to [get_pins {g_uart?2?.u_uart.u_shim.sync0_q$_DFF_PN1_/D}]
set_false_path -from [get_ports boot_sel]  -to [get_pins {u_reset_ctrl.u_apb.bsel_q?0?$_DFF_PN0_/D}]
set_false_path -from [get_ports spis_sclk] -to [get_pins {g_spis.u_spis.u_shim.sync0_q?0?$_DFF_PN0_/D}]
set_false_path -from [get_ports spis_mosi] -to [get_pins {g_spis.u_spis.u_shim.sync0_q?1?$_DFF_PN0_/D}]
set_false_path -from [get_ports spis_cs_n] -to [get_pins {g_spis.u_spis.u_shim.sync0_q?2?$_DFF_PN1_/D}]
set_false_path -from [get_ports {gpio_i[0]}] -to [get_pins {u_gpio.u_shim.sync0_q?0?$_DFF_PN0_/D}]
set_false_path -from [get_ports {gpio_i[1]}] -to [get_pins {u_gpio.u_shim.sync0_q?1?$_DFF_PN0_/D}]
set_false_path -from [get_ports i2c_scl_i] -to [get_pins {u_i2c.u_shim.sync0_q?0?$_DFF_PN1_/D}]
set_false_path -from [get_ports i2c_sda_i] -to [get_pins {u_i2c.u_shim.sync0_q?1?$_DFF_PN1_/D}]

# ---- 9. not set (library / package dependent): max transition/cap/fanout,
#      driving cells, output loads, uncertainty on derived clocks (no document
#      gives one). Memory macros are black boxes with no timing arcs: every
#      path to or from an sram_wrapper is UNCONSTRAINED in this scenario.
