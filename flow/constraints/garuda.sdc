# =============================================================================
# GARUDA chip-level timing constraints: TARGET (TSMC 28 nm) DRAFT, rev 2 (2026-10-13)
#
# STATUS: draft. Not validated against a 28 nm netlist or library; no 28 nm
# library is available. Time unit: ns (adjust if the foundry liberty differs).
#
# The STRUCTURE of this file was validated on 2026-10-13 against the RTL and
# against an exploratory ASAP7 netlist (flow/constraints/asap7/, generated by
# gen_modes.py; results in Docs/logs/pd/PD_LOG_2026-10-13.md). In those runs
# every command matched its intended objects, with no unclocked registers and
# no clock loops. Object names below are RTL-level (Genus-style `_reg`) and must
# be re-matched on the 28 nm netlist (TBD D7).
#
# Four timing scenarios, one per DIVSEL value (section 3): DIV2 is the primary
# target, and DIV4/8/16 are separate modes. Select one with
#   set GARUDA_DIV 2   (or 4, 8, 16)   before sourcing this file.
#
# Values: only refclk 500 MHz (ADR-0001, CLKRST R-1), its 0.10 ns transition
# and 0.15 ns setup uncertainty (PHYS 5.2), and tck <= 20 MHz (yaml) come from
# documents. Everything marked PROVISIONAL is a placeholder with its
# assumptions stated in the same place.
# =============================================================================
if {![info exists GARUDA_DIV]} { set GARUDA_DIV 2 }
set REFCLK_NS 2.000
set HCLK_NS   [expr {$REFCLK_NS * $GARUDA_DIV}]
set PCLK_NS   [expr {$HCLK_NS * 2}]
set TCK_NS    50.000
set IO_PCT    0.30          ;# PROVISIONAL I/O budget fraction (section 7)

# ---- object names (TBD D7: confirm on the 28 nm netlist) --------------------
set T1   u_clk_div/t1_q_reg
set T2   u_clk_div/t2_q_reg
set T3   u_clk_div/t3_q_reg
set T4   u_clk_div/t4_q_reg
set SEL0 u_clk_div/sel_act_q_reg[0]
set SEL1 u_clk_div/sel_act_q_reg[1]
set PCLK u_clk_div/pclk_q_reg
set HMUX [get_pins -of_objects [get_nets u_clk_div/hclk_mux] -filter "direction == output"]

# 1. reference: reaches only t1_q (R-10; fanout 1 checked on the ASAP7 netlist)
create_clock -name refclk -period $REFCLK_NS [get_ports refclk]
set_input_transition 0.10 [get_ports refclk]
set_clock_uncertainty -setup 0.15 [get_clocks refclk]

# 2. ripple divider; aon_clk = t1 (D-14). Every derived clock is given its exact
#    edges counted in refclk edges (edge 1 = refclk rise at 0): t1 toggles on
#    each refclk rise, and t2..t4 toggle on the previous stage's rise, so every
#    divider rise lands on a t1 rise. Validated on ASAP7 (gen_modes.py): a plain
#    -divide_by (and -invert) on inverted-output pins put aon_clk half a period
#    out of phase with hclk, which made hold OPTIMISTIC by one refclk period.
#    Q-pin edges below; if the 28 nm flops expose only QN, use gen_modes.py's QN
#    edges.
create_generated_clock -name aon_clk -source [get_ports refclk] -edges {1 3 5}   [get_pins $T1/Q]
create_generated_clock -name clk_t2 -source [get_ports refclk] -edges {1 5 9}   [get_pins $T2/Q]
create_generated_clock -name clk_t3 -source [get_ports refclk] -edges {1 9 17}  [get_pins $T3/Q]
create_generated_clock -name clk_t4 -source [get_ports refclk] -edges {1 17 33} [get_pins $T4/Q]

# 3. hclk = DIVSEL mux, fixed per scenario by case analysis on sel_act_q
array set SELV {2 {0 0} 4 {1 0} 8 {0 1} 16 {1 1}}
set_case_analysis [lindex $SELV($GARUDA_DIV) 0] [get_pins $SEL0/Q]
set_case_analysis [lindex $SELV($GARUDA_DIV) 1] [get_pins $SEL1/Q]
set D $GARUDA_DIV
create_generated_clock -name hclk -source [get_ports refclk] \
    -edges [list 1 [expr {1 + $D}] [expr {1 + 2*$D}]] $HMUX

# 4. pclk = hclk / 2 (pclk_q resets to 1, so Q falls on the first hclk rise)
create_generated_clock -name pclk -source [get_ports refclk] \
    -edges [list [expr {1 + 2*$D}] [expr {1 + 4*$D}] [expr {1 + 6*$D}]] [get_pins $PCLK/Q]
# 4b. derived-clock setup uncertainty: ASSUMPTION (provisional). No document
#     gives one; reuses refclk's PHYS 5.2 value at the user's direction
#     (2026-10-13). Setup only; no hold uncertainty is set.
set_clock_uncertainty -setup 0.15 [get_clocks {aon_clk clk_t2 clk_t3 clk_t4 hclk pclk}]
# One synchronous family (aon_clk, clk_t2..t4, hclk, pclk, the core's gated
# clock): NO clock groups, NO false paths among them (PHYS [N-5.7]).

# 5. JTAG: asynchronous to the family, but NOT grouped away. The only crossing
#    is dmi_cdc.v (toggle handshake plus held payload). Hold between unrelated
#    clocks is meaningless; setup is BOUNDED at one hclk period. PROVISIONAL-X1.
create_clock -name tck -period $TCK_NS [get_ports tck]
set_false_path -hold -from [get_clocks tck] -to [get_clocks {aon_clk hclk pclk}]
set_false_path -hold -from [get_clocks {aon_clk hclk pclk}] -to [get_clocks tck]
set_max_delay $HCLK_NS -ignore_clock_latency -from [get_clocks tck] -to [get_clocks {aon_clk hclk pclk}]
set_max_delay $HCLK_NS -ignore_clock_latency -from [get_clocks {aon_clk hclk pclk}] -to [get_clocks tck]

# 6. ext_rst_n: only its asynchronous reset/set pins. On ASAP7 all 183 loads
#    were RESETN/SETN with no data use: u_clk_div (raw reset, [N-7.16]),
#    u_reset_ctrl (release synchronisers, stretch counter held by ext_held,
#    RSTREASON), and u_debug (jtag_tap/dtm/dmi_cdc por_n, tck domain). The pin
#    has no clock (PHYS B-1). Re-check that the load list is the same on 28 nm.
set_false_path -from [get_ports ext_rst_n] \
    -to [get_pins -of_objects [get_nets ext_rst_n] -filter "direction == input"]

# 7. I/O, PROVISIONAL: budget = IO_PCT of the relevant period. Assumptions:
#    pad + board fit that budget; SPI flash/IMU unknown (generic outputs on
#    pclk; spim_miso is synchronised in RTL); JTAG probe launches on tck fall
#    and samples on tck rise; no loads or drive cells set.
set_input_delay  [expr {$TCK_NS * $IO_PCT}] -clock tck [get_ports {tms tdi}]
#    Ports: garuda_chip_core (P2): former tri-state pins are data + enable outputs.
set_output_delay [expr {$TCK_NS * $IO_PCT}] -clock tck [get_ports {tdo_o tdo_oe_o}]
set_output_delay -min 0 -clock tck [get_ports {tdo_o tdo_oe_o}]
set OUTS_PCLK {spim_sclk spim_mosi spim_cs_flash_n spim_cs_imu_n uart0_tx uart1_tx uart2_tx
               pwm0 pwm1 pwm2 pwm3 gpio_o* gpio_oe_o* i2c_scl_o i2c_scl_oe_o
               i2c_sda_o i2c_sda_oe_o spis_miso_o spis_miso_oe_o}
set_output_delay [expr {$PCLK_NS * $IO_PCT}] -clock pclk [get_ports $OUTS_PCLK]
set_output_delay -min 0 -clock pclk [get_ports $OUTS_PCLK]

# 8. asynchronous inputs: port -> its first synchroniser flop only
#    (verified on ASAP7: that D pin is each port's only load)
set_false_path -from [get_ports spim_miso] -to [get_pins u_spim/u_shim/sync0_q_reg/D]
set_false_path -from [get_ports uart0_rx]  -to [get_pins g_uart[0].u_uart/u_shim/sync0_q_reg/D]
set_false_path -from [get_ports uart1_rx]  -to [get_pins g_uart[1].u_uart/u_shim/sync0_q_reg/D]
set_false_path -from [get_ports uart2_rx]  -to [get_pins g_uart[2].u_uart/u_shim/sync0_q_reg/D]
set_false_path -from [get_ports boot_sel]  -to [get_pins u_reset_ctrl/u_apb/bsel_q_reg[0]/D]
set_false_path -from [get_ports spis_sclk] -to [get_pins g_spis.u_spis/u_shim/sync0_q_reg[0]/D]
set_false_path -from [get_ports spis_mosi] -to [get_pins g_spis.u_spis/u_shim/sync0_q_reg[1]/D]
set_false_path -from [get_ports spis_cs_n] -to [get_pins g_spis.u_spis/u_shim/sync0_q_reg[2]/D]
set_false_path -from [get_ports {gpio_i[0]}] -to [get_pins u_gpio/u_shim/sync0_q_reg[0]/D]
set_false_path -from [get_ports {gpio_i[1]}] -to [get_pins u_gpio/u_shim/sync0_q_reg[1]/D]
set_false_path -from [get_ports i2c_scl_i]   -to [get_pins u_i2c/u_shim/sync0_q_reg[0]/D]
set_false_path -from [get_ports i2c_sda_i]   -to [get_pins u_i2c/u_shim/sync0_q_reg[1]/D]

# 9. Clock gating: with P1 (GARUDA_ICG_CELL + the flow's OPENROAD_CLKGATE) the
#    gate is the library ICG, whose clock-gating check comes from its liberty;
#    the 28 nm flow must map OPENROAD_CLKGATE (or the instance) to the foundry ICG.
# 10. Not set: max transition/cap/fanout, drive cells, loads, hold uncertainty.
# DFT (scope pending): scan would add test-mode clocking (scan clock(s), the
#    ICG test_en_i, which is tied 0 today) and a reset bypass (clk_div raw reset,
#    reset_ctrl's flop-driven async sets). Each needs its own constraints. Not
#    designed for here.
