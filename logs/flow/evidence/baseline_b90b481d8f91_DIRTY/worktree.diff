diff --git a/.gitignore b/.gitignore
index 790c03a..9ab9dc1 100644
--- a/.gitignore
+++ b/.gitignore
@@ -75,3 +75,13 @@ fpga/kv260/.Xil/
 fpga/kv260/garuda.dtbo
 *.jou
 *.log.bak
+
+# ---- Track A open-tool flow (Docs/handbook/H2_running.md, "Log convention") ----
+# Per-run logs, builds, waves and coverage databases stay local; summaries,
+# history and cited evidence are committed. *.log is ignored above, so the
+# committed evidence logs are re-included explicitly.
+logs/**/raw/
+!logs/**/evidence/*.log
+.garuda_bin/
+obj_dir/
+*.vvp
